{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "python3 hooks/protected-branch/pre_tool_use.py",
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "type": "command",
        "command": "python3 hooks/protected-branch/pre_tool_use.py",
        "matcher": "Bash"
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "bash hooks/markdown/format_markdown.sh",
        "matcher": "Edit|Write"
      },
      {
        "type": "command",
        "command": "bash hooks/spec/validate_document.sh",
        "matcher": "Edit|Write"
      },
      {
        "type": "command",
        "command": "bash hooks/spec/validate_prompts.sh",
        "matcher": "Edit|Write"
      }
    ]
  }
}
