{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/permissions-schema.json",
  "permission": {
    "bash": {
      "rm -rf /:*": "deny",
      "rm -rf ~:*": "deny",
      "rm -rf /*": "deny",

      "git status:*": "allow",
      "git diff:*": "allow",
      "git log:*": "allow",
      "git show:*": "allow",
      "git branch:*": "allow",
      "git fetch:*": "allow",
      "git remote:*": "allow",
      "git tag:*": "allow",
      "git config:*": "allow",
      "git add:*": "allow",
      "git commit:*": "allow",
      "git switch:*": "allow",
      "git checkout:*": "allow",
      "git stash:*": "allow",
      "git restore:*": "allow",
      "git rm:*": "allow",
      "git mv:*": "allow",
      "git merge:*": "allow",
      "git rebase:*": "allow",
      "git pull:*": "allow",
      "git worktree:*": "allow",
      "git reset:*": "allow",
      "git cherry-pick:*": "allow",
      "git blame:*": "allow",
      "git rev-parse:*": "allow",
      "git describe:*": "allow",
      "git push:*": "ask",
      "git reset --hard:*": "ask",
      "git clean:*": "ask",

      "gh pr view:*": "allow",
      "gh pr list:*": "allow",
      "gh pr diff:*": "allow",
      "gh pr status:*": "allow",
      "gh pr checks:*": "allow",
      "gh issue view:*": "allow",
      "gh issue list:*": "allow",
      "gh repo view:*": "allow",
      "gh run list:*": "allow",
      "gh run view:*": "allow",
      "gh search:*": "allow",
      "gh label list:*": "allow",
      "gh api:*": "allow",
      "gh pr create:*": "allow",
      "gh pr comment:*": "allow",
      "gh pr edit:*": "allow",
      "gh issue create:*": "allow",
      "gh issue comment:*": "allow",
      "gh issue edit:*": "allow",
      "gh pr merge:*": "ask",
      "gh pr close:*": "ask",
      "gh issue close:*": "ask",
      "gh repo delete:*": "ask",
      "gh release create:*": "ask",

      "rg:*": "allow",

      "docker ps:*": "allow",
      "docker images:*": "allow",
      "docker logs:*": "allow",
      "docker inspect:*": "allow",
      "docker version": "allow",
      "docker info": "allow",
      "docker build:*": "allow",
      "docker run:*": "allow",
      "docker exec:*": "allow",
      "docker start:*": "allow",
      "docker stop:*": "allow",
      "docker restart:*": "allow",
      "docker pull:*": "allow",
      "docker compose up:*": "allow",
      "docker compose down:*": "allow",
      "docker compose build:*": "allow",
      "docker compose ps:*": "allow",
      "docker compose logs:*": "allow",
      "docker compose exec:*": "allow",
      "docker compose run:*": "allow",
      "docker rm:*": "ask",
      "docker rmi:*": "ask",
      "docker system prune:*": "ask",
      "docker image prune:*": "ask",
      "docker container prune:*": "ask",
      "docker volume rm:*": "ask",
      "docker network rm:*": "ask",

      "npx rulesync:*": "allow",
      "rulesync:*": "allow",
      "codex exec:*": "allow",

      "ls:*": "allow",
      "cat:*": "allow",
      "find:*": "allow",
      "tree:*": "allow",
      "wc:*": "allow",
      "head:*": "allow",
      "tail:*": "allow",
      "which:*": "allow",
      "pwd": "allow",
      "stat:*": "allow",
      "file:*": "allow",
      "du:*": "allow",
      "df:*": "allow",

      "rm:*": "ask"
